# TACU installer and runtime defaults.
# Copy this file to .env in the same directory, edit, then run:
#   chmod +x install.sh && ./install.sh
#
# First run does not require .env — the values below are already the built-in
# defaults. Use .env only when you want to pin or skip something without
# editing install.sh.

# --- Chat models ---
# Apple Silicon primary. Setup pulls this only if neither it nor TACU_BACKUP_MODEL is already installed.
TACU_MODEL=gemma4:12b-mlx
# Used when already on the machine; setup does not download it automatically.
TACU_BACKUP_MODEL=qwen2.5-coder:7b

# Keep the model loaded for 15 minutes after the last request. Request budget is 15 minutes.
TACU_KEEP_ALIVE=15m
TACU_TIMEOUT=900
TACU_OLLAMA_URL=http://127.0.0.1:11434
# Gemma 4 thinks before it writes. 256 tokens often never reaches the visible answer.
TACU_NUM_PREDICT=1024

# --- Ollama (Apple Silicon MLX) ---
# Fresh macOS installs pin this GitHub release. Already-installed builds at or
# above this version are left alone. Older builds prompt to upgrade.
TACU_OLLAMA_VERSION=0.32.14
# Non-interactive (CI / unattended): upgrade Ollama when below the pin.
# TACU_UPGRADE_OLLAMA=1

# --- Local search for `ti web` ---
# Optional. Leave unset so TACU starts tacu-searxng on 127.0.0.1:8080 (or the next free port).
# TACU_SEARXNG_URL=http://127.0.0.1:8080

# --- Python ---
# Use an already-installed 3.11+ interpreter, or leave unset to auto-detect.
# If none is usable, the installer downloads Python 3.14.7 from python.org.
# TACU_PYTHON=/opt/homebrew/bin/python3.14
TACU_PYTHON_VERSION=3.14.7

# --- Optional skips (same as ./install.sh --skip-*) ---
# SKIP_OLLAMA=0
# SKIP_MODELS=0
# SKIP_DOCKER=0
